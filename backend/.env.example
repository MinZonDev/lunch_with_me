# Copy thành .env và điền giá trị thực

# Firebase — một trong hai cách xác thực:
# Cách 1: đường dẫn tới file Service Account JSON tải từ Firebase Console
FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json
# Cách 2: dùng GOOGLE_APPLICATION_CREDENTIALS (cho Cloud Run / GKE)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Firebase Storage — bucket chứa ảnh menu quán (Firebase Console → Storage)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# JWT — PHẢI đổi thành chuỗi random 64 ký tự trước khi deploy!
JWT_SECRET=change-me-to-a-very-long-random-secret-string-minimum-32-chars
JWT_EXPIRE_HOURS=8

# Gmail SMTP — dùng App Password (không phải mật khẩu thường)
# Bật tại: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# App URLs
FRONTEND_URL=http://localhost:3000

# Tắt job nền (nhắc nhở, auto-lock, random người lấy cơm) khi chạy local trỏ vào project thật
# ENABLE_SCHEDULER=false
# Trên Cloud Run: ENABLE_SCHEDULER=false + CRON_SECRET, Cloud Scheduler gọi
# POST /api/internal/cron/tick mỗi phút với header X-Cron-Secret
# CRON_SECRET=

# Business logic
LOW_BALANCE_THRESHOLD=50
ORDER_DEADLINE_DEFAULT=11:00
