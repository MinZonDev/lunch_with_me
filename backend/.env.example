# Copy file này thành .env và điền giá trị thực

# Database
DATABASE_URL=sqlite:///./lunch.db

# JWT - PHẢI đổi key này trước khi deploy!
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRE_HOURS=8

# Outlook SMTP
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=your@outlook.com
SMTP_PASSWORD=your-outlook-app-password

# App
FRONTEND_URL=http://localhost:3000
LOW_BALANCE_THRESHOLD=50
ORDER_DEADLINE_DEFAULT=11:30
