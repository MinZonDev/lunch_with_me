# Copy thành .env và điền giá trị thực

# Firebase — một trong hai cách xác thực:
# Cách 1: đường dẫn tới file Service Account JSON tải từ Firebase Console
FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json
# Cách 2: dùng GOOGLE_APPLICATION_CREDENTIALS (cho Cloud Run / GKE)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# JWT — PHẢI đổi thành chuỗi random 64 ký tự trước khi deploy!
JWT_SECRET=change-me-to-a-very-long-random-secret-string-minimum-32-chars
JWT_EXPIRE_HOURS=8

# Outlook SMTP
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=your@outlook.com
SMTP_PASSWORD=your-outlook-app-password

# App URLs
FRONTEND_URL=http://localhost:3000

# Business logic
LOW_BALANCE_THRESHOLD=50
ORDER_DEADLINE_DEFAULT=11:30
